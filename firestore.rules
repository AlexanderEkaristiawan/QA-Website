rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow all authenticated users to read/write any collection used by the app
    match /projects/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /audit_jobs/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /bug_list/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /test_cases/{document=**} {
      allow read, write: if request.auth != null;
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

