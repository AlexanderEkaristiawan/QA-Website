{
  "manifest_version": 3,
  "name": "DevTools Screen Simulator",
  "version": "1.0",
  "description": "Simulates custom device viewports in a resizable, side-by-side workspace like Chrome DevTools device mode.",
  "permissions": [
    "declarativeNetRequest",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Screen Simulator"
  }
}
